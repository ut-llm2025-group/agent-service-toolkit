  <graph edgedefault="undirected">
    <node id="Marisol">
      <data key="d0">Marisol</data>
      <data key="d1">person</data>
      <data key="d2">Marisol is a character who discovers an old mirror in the attic and enters a mystical garden through its reflection.</data>
      <data key="d3">chunk-7dbbd3e72d696acd9b85621cdff97d7f</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1754068653</data>
    </node>
    <node id="The Mirror">
      <data key="d0">The Mirror</data>
      <data key="d1">category</data>
      <data key="d2">The Mirror appears to be a magical portal that connects the real world with a timeless realm.</data>
      <data key="d3">chunk-7dbbd3e72d696acd9b85621cdff97d7f</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1754068653</data>
    </node>
    <node id="The Garden">
      <data key="d0">The Garden</data>
      <data key="d1">category</data>
      <data key="d2">The Garden is a mystical, dreamlike place where time and reality are distorted.</data>
      <data key="d3">chunk-7dbbd3e72d696acd9b85621cdff97d7f</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1754068653</data>
    </node>
    <node id="The Woman in Smoke Hair">
      <data key="d0">The Woman in Smoke Hair</data>
      <data key="d1">person</data>
      <data key="d2">The Woman in Smoke Hair is a mysterious figure who beckons Marisol into the mirror realm.</data>
      <data key="d3">chunk-7dbbd3e72d696acd9b85621cdff97d7f</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1754068653</data>
    </node>
    <node id="The Crow">
      <data key="d0">The Crow</data>
      <data key="d1">person</data>
      <data key="d2">The Crow is an enigmatic guide that speaks in riddles and helps Marisol navigate the mirror world.</data>
      <data key="d3">chunk-7dbbd3e72d696acd9b85621cdff97d7f</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1754068653</data>
    </node>
    <node id="Attic">
      <data key="d0">Attic</data>
      <data key="d1">geo</data>
      <data key="d2">The Attic is a location where Marisol finds the old mirror and enters the mirror realm.</data>
      <data key="d3">chunk-7dbbd3e72d696acd9b85621cdff97d7f</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1754068653</data>
    </node>
    <node id="Parents">
      <data key="d0">Parents</data>
      <data key="d1">person</data>
      <data key="d2">Marisol's parents are mentioned as calling her name in empty halls.</data>
      <data key="d3">chunk-7dbbd3e72d696acd9b85621cdff97d7f</data>
      <data key="d4">unknown_source</data>
